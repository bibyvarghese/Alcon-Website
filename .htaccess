DirectoryIndex Index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 400 /404.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml application/xml image/svg+xml
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000, immutable" "expr=%{REQUEST_URI} =~ m#\.(css|js|png|jpg|jpeg|gif|svg|webp|mp4|woff|woff2)$#"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
</IfModule>

RewriteEngine On

RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.html/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L,NC]

RewriteCond %{REQUEST_URI} \.html/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L,NC]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.alcon.ae%{REQUEST_URI} [R=301,L]

Options -Indexes -MultiViews

RewriteRule ^(?:\.git|\.svn|\.hg|\.env|admin|wp-admin|phpmyadmin|cgi-bin|node_modules|vendor|backup|logs)(?:/|$) - [R=404,L,NC]
RewriteRule ^(?:.*\.){2,}.*$ - [R=404,L,NC]
RewriteRule ^([^/]+/)+[^/]+/?$ - [R=404,L,NC]

<FilesMatch "^(\.git|\.env|composer\.(json|lock)|package(-lock)?\.json|.*\.bak|.*\.sql)$">
    Require all denied
</FilesMatch>
