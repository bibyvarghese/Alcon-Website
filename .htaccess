DirectoryIndex Index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteRule ^.*\.html/.+$ - [R=404,L,NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.alcon.ae%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
</IfModule>

Options -Indexes -MultiViews

RewriteRule ^\.git(?:/|$) - [F,L]

<FilesMatch "^(\.git|\.env|composer\.(json|lock)|package(-lock)?\.json|.*\.bak|.*\.sql)$">
    Require all denied
</FilesMatch>
